{
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
	"rules": {
		"no-unused-vars": "warn",
		"@typescript-eslint/no-explicit-any": "warn",
		"@typescript-eslint/no-non-null-assertion": "off"
	},
	"ignorePatterns": [
		"**/node_modules",
		"**/dist",
		"**/build",
		"**/*.gen.ts",
		"**/generated.ts",
		"**/generated.msw.ts",
		"openapi.json",
		".sqlx",
		"crates/yauth-toasty/toasty/snapshots"
	],
	"overrides": [
		{
			"files": ["**/*.vue"],
			"rules": {
				"no-unused-vars": "off"
			}
		}
	]
}
