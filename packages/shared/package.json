{
  "name": "@yackey-labs/yauth-shared",
  "version": "0.13.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yackey-labs/yauth"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./dist/types.mjs"
    },
    "./aaguid": {
      "types": "./src/aaguid.ts",
      "import": "./dist/aaguid.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/types.ts src/aaguid.ts --dts",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
