{
	"name": "@yackey-labs/yauth-shared",
	"version": "0.12.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/yackey-labs/yauth"
	},
	"type": "module",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./types": {
			"types": "./dist/types.d.mts",
			"import": "./dist/types.mjs"
		},
		"./aaguid": {
			"types": "./dist/aaguid.d.mts",
			"import": "./dist/aaguid.mjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "vp pack src/index.ts src/types.ts src/aaguid.ts --dts",
		"typecheck": "tsc --noEmit",
		"test": "vp test run"
	},
	"devDependencies": {
		"typescript": "^5.7.2"
	}
}
