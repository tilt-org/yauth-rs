# Server A — yauth-as-IdP runtime env. Sourced by docker-compose.yml.
YAUTH_BACKEND=memory
PORT=8080
BASE_URL=http://localhost:8080
JWT_SECRET=idp-dev-secret-do-not-use-in-prod
ALLOW_SIGNUPS=true
PASSKEY_RP_ID=localhost
PASSKEY_RP_ORIGIN=http://localhost:8080
PASSKEY_RP_NAME=Server A (IdP)
MFA_ISSUER=Server A IdP
RUST_LOG=info,yauth=debug
