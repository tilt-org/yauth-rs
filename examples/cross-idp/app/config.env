# Server B — yauth-as-App runtime env. Sourced by docker-compose.yml.
YAUTH_BACKEND=memory
PORT=8081
BASE_URL=http://localhost:8081
JWT_SECRET=app-dev-secret-do-not-use-in-prod
ALLOW_SIGNUPS=true
PASSKEY_RP_ID=localhost
PASSKEY_RP_ORIGIN=http://localhost:8081
PASSKEY_RP_NAME=Server B (App)
MFA_ISSUER=Server B App
RUST_LOG=info,yauth=debug
